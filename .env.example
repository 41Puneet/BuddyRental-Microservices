# =============================================================================
# BuddyRental — Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before starting any service.
# NEVER commit the filled .env file — it is listed in every .gitignore.
#
# How to use (local development):
#   export $(cat .env | xargs)    # bash/zsh
#   or use a tool like direnv / IntelliJ Run Configurations / Docker Compose
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Shared MySQL root password used by all services.
# For production: create a separate least-privilege user per service.
DB_PASSWORD=your_mysql_password_here

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Base64-encoded HMAC-SHA256 signing key (minimum 256 bits / 32 bytes).
# Generate one: openssl rand -base64 32
JWT_SECRET=your_base64_encoded_jwt_secret_here

# ---------------------------------------------------------------------------
# RAZORPAY  (payment_service only)
# ---------------------------------------------------------------------------
# Obtain from https://dashboard.razorpay.com/app/keys
# Use live keys only in production — always use test keys in development.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ---------------------------------------------------------------------------
# CORS  (api-gateway only)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example for production: https://app.buddyrental.in
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# NOTIFICATION SERVICE  (notification_service)
# ---------------------------------------------------------------------------
# SMTP credentials for sending email notifications.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=noreply@buddyrental.in

# ---------------------------------------------------------------------------
# SECRET ROTATION REMINDER
# ---------------------------------------------------------------------------
# Before going live:
# 1. Generate a fresh DB_PASSWORD per database schema
# 2. Generate a new JWT_SECRET (never reuse across environments)
# 3. Rotate RAZORPAY keys in the Razorpay dashboard
# 4. Ensure these values are injected via your deployment platform
#    (e.g. AWS Parameter Store, Doppler, Docker secrets) — not committed here
