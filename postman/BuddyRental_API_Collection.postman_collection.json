    {
      "name": "User Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"phoneNumber\": \"+919876543210\",\n  \"password\": \"Password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": { "raw": "{{base_url_user}}/api/auth/register" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('access_token', body.accessToken);",
                  "pm.environment.set('refresh_token', body.refreshToken);",
                  "if (body.accessToken) {",
                  "  const parts = body.accessToken.split('.');",
                  "  if (parts.length === 3) {",
                  "    const base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "    const padded = base64 + '==='.slice((base64.length + 3) % 4);",
                  "    const payload = JSON.parse(atob(padded));",
                  "    if (payload.userId) pm.environment.set('user_id', payload.userId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
